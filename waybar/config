{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 0,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,

    "modules-left": ["custom/menu", "hyprland/window"],
    "modules-center": [],
    "modules-right": ["cpu", "memory", "custom/gpu", "pulseaudio", "network", "battery", "clock"],

    "custom/menu": {
        "format": " ",
        "on-click": "fuzzel",
        "tooltip": false
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 50
    },

    "clock": {
        "format": "{:%H:%M  %d/%m/%Y}",
        "tooltip": false
    },

    "cpu": {
        "format": " {usage}%",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "format": " {percentage}%",
        "interval": 2,
        "tooltip": false
    },

    "custom/gpu": {
        "exec": "cat /sys/class/drm/card1/device/gpu_busy_percent",
        "format": " {}%",
        "interval": 2,
        "tooltip": false
    },

    "network": {
        "format-wifi": " {signalStrength}%",
        "format-ethernet": " {ipaddr}",
        "format-disconnected": "⚠",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pamixer -t",
        "tooltip": false
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip": false
    }
}
